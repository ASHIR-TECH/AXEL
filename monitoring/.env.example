# AXEL monitoring/alerting configuration.
# Copy these values into the repository root `.env` (Compose reads it).
# Never commit real credentials.

# ── Pager (PagerDuty Events API v2) ────────────────────────────────────────
# Leave empty to disable the pager channel.
PAGERDUTY_INTEGRATION_KEY=

# ── Generic JSON webhook (Slack relay, Opsgenie, incident.io, ...) ─────────
# Receives the original Alertmanager webhook payload.
ALERT_WEBHOOK_URL=

# ── Telegram operator channel (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=

# Log deliveries without making outbound calls. Useful for a first run.
ALERT_RELAY_DRY_RUN=false

# ── Local ports (bound to 127.0.0.1 by Compose) ───────────────────────────
AXEL_METRICS_PORT=9108
AXEL_ALERT_RELAY_PORT=9110
AXEL_PROMETHEUS_PORT=9090
AXEL_ALERTMANAGER_PORT=9093
AXEL_GRAFANA_PORT=3000

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-exposing
GRAFANA_ROOT_URL=http://localhost:3000
