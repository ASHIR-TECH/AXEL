# AXEL Environment Configuration Template
# Copy this file to .env for local paper trading. NEVER commit real credentials.

# System Execution Mode
ENVIRONMENT=paper
LIVE_TRADING_CONFIRMED=false
LOG_LEVEL=INFO

# PostgreSQL + TimescaleDB
DATABASE_URL=sqlite:///./axel.db
# For production/TimescaleDB container:
# DATABASE_URL=postgresql+psycopg://axel:axelpass@localhost:5432/axel
REDIS_URL=redis://localhost:6379/0

# Broker: Alpaca (Equities) - Trade-only keys; withdrawals DISABLED
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Human-In-The-Loop (HITL) Gateway & Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OPERATOR_CHAT_ID=your_chat_id
OPERATOR_REARM_SECRET=change_this_to_a_secure_rearm_token_for_killswitch

# AI Providers (Used in Agent Service only, NEVER in Trading Core)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
# Selected agent provider: none | groq | qwen
LLM_PROVIDER=none
QWEN_API_KEY=your_qwen_api_key
# Qwen is region/workspace-specific; use your compatible-mode base URL:
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.7-plus

# Telegram Signal Ingestion (reads betting + trading signals from groups)
# Runs as the operator's OWN Telegram account via Telethon, separate from the
# alert bot above. Comma-separated group usernames/IDs to monitor:
SIGNAL_CHATS=
# Optional: only trust these numeric Telegram sender IDs (empty = accept all)
SIGNAL_ALLOWED_USER_IDS=
# Minimum parsed trade confidence before a signal becomes a risk-gated proposal
SIGNAL_MIN_TRADE_CONFIDENCE=0.50
# Telegram developer credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telethon session file name (kept out of git; see .gitignore *.session)
TELEGRAM_SESSION=axel_tele_signal

# Deterministic Risk Limits (Hardcoded overrides / defaults)
GLOBAL_KILL_PCT=0.10
SECTION_DAILY_STOP_PCT=0.03
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.05
MAX_PER_TRADE_RISK_PCT=0.01
## Paper-only data and LLM configuration (leave blank until required)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# FRED_API_KEY=
# SEC_USER_AGENT="Your Name contact@example.com"
# GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# LLM_HOURLY_BUDGET_USD=0.25
# LLM_DAILY_BUDGET_USD=1.00
