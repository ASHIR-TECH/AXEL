# AXEL Environment Configuration Template
# Copy this file to .env for local paper trading. NEVER commit real credentials.

# System Execution Mode
ENVIRONMENT=paper
LIVE_TRADING_CONFIRMED=false
LOG_LEVEL=INFO

# PostgreSQL + TimescaleDB
DATABASE_URL=sqlite:///./axel.db
# For production/TimescaleDB container:
# DATABASE_URL=postgresql+psycopg2://axel:axelpass@localhost:5432/axel
REDIS_URL=redis://localhost:6379/0

# Broker: Alpaca (Equities) - Trade-only keys; withdrawals DISABLED
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Human-In-The-Loop (HITL) Gateway & Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OPERATOR_CHAT_ID=your_chat_id
OPERATOR_REARM_SECRET=change_this_to_a_secure_rearm_token_for_killswitch

# AI Providers (Used in Agent Service only, NEVER in Trading Core)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# Deterministic Risk Limits (Hardcoded overrides / defaults)
GLOBAL_KILL_PCT=0.10
SECTION_DAILY_STOP_PCT=0.03
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.05
MAX_PER_TRADE_RISK_PCT=0.01
## Paper-only data and LLM configuration (leave blank until required)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# FRED_API_KEY=
# SEC_USER_AGENT="Your Name contact@example.com"
# GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# LLM_HOURLY_BUDGET_USD=0.25
# LLM_DAILY_BUDGET_USD=1.00
